# DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# Domínios do front, separados por vírgula, sem barra no final. Sem esta variável, qualquer origem é aceita.
# ALLOWED_ORIGINS=https://seu-app.vercel.app
